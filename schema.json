openapi: 3.0.3
info:
  title: ATM Monitoring API
  version: 1.0.0
  description: ATM monitoring, business analytics, maintenance and dashboard API
paths:
  /api/v1/analytics/atms/loss-making/:
    get:
      operationId: v1_analytics_atms_loss_making_list
      description: 'Haqiqiy xarajati daromadidan oshib ketayotgan muammoli bankomatlarni
        aniqlash. Bazadagi real ma''lumotlarga tayangan holda (Ollama ishlatilmaydi)
        qat''iy amaliy tavsiyalar: past aylanmali nuqtalarni savdo markazlariga ko''chirish
        (relokatsiya), yuqori ta''mirlash xarajatlilarni audit qilish, ijara stavkasini
        pasaytirish yoki inkassatsiya grafigini optimallashtirish.'
      summary: Zarardagi bankomatlar va Joyini almashtirish (Relokatsiya) tavsiyalari
      parameters:
      - in: query
        name: limit
        schema:
          type: integer
          default: 20
        description: 'Natijalar sonini tanlang (default: 20)'
      - in: query
        name: min_loss
        schema:
          type: integer
        description: Minimal zarar miqdori chegarasi (so'mda)
      - in: query
        name: month
        schema:
          type: integer
          enum:
          - 1
          - 10
          - 11
          - 12
          - 2
          - 3
          - 4
          - 5
          - 6
          - 7
          - 8
          - 9
        description: Oyni tanlang
      - in: query
        name: region
        schema:
          type: string
          enum:
          - Andijon
          - Булунғур
          - Булунғур БРМ
          - Бухоро
          - Гулистон
          - Жиззах
          - Зангиота
          - М.Улуғбек
          - МАБ
          - Мирзо Улуғбек
          - Миробод
          - Навоий
          - Наманган
          - Нукус
          - Самарқанд
          - Термиз
          - Урганч
          - Фарғона
          - Чилонзор
          - Шаҳрисабз
          - Юнусобод
          - Яшнобод
          - Қарши
        description: Viloyatni tanlang
      - in: query
        name: year
        schema:
          type: integer
          enum:
          - 2024
          - 2025
          - 2026
        description: Yilni tanlang
      tags:
      - Analytics
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/LossMakingATM'
          description: ''
  /api/v1/analytics/atms/top-expense/:
    get:
      operationId: v1_analytics_atms_top_expense_list
      description: 'Bank uchun eng ko''p rasxod talab qilgan bankomatlar reytingi.
        Xarajatlar taqsimoti: ehtiyot qismlar va ta''mirlash, ijara to''lovi, elektr
        energiyasi, inkassatsiya xizmati va shartnoma to''lovlari (BTech, Glob). Shuningdek,
        bankomat qancha daromad bergani va sof natijasi (foyda/zarar).'
      summary: Eng ko'p haqiqiy rasxod qilgan bankomatlar (Top Expense ATMs)
      parameters:
      - in: query
        name: expense_type
        schema:
          type: string
          enum:
          - all
          - electricity
          - incassation
          - maintenance
          - rent
        description: Saralash xarajat turi (all, maintenance, rent, electricity, incassation)
      - in: query
        name: limit
        schema:
          type: integer
          default: 10
        description: 'Qaytariladigan bankomatlar soni (default: 10)'
      - in: query
        name: month
        schema:
          type: integer
          enum:
          - 1
          - 10
          - 11
          - 12
          - 2
          - 3
          - 4
          - 5
          - 6
          - 7
          - 8
          - 9
        description: Oyni tanlang
      - in: query
        name: region
        schema:
          type: string
          enum:
          - Andijon
          - Булунғур
          - Булунғур БРМ
          - Бухоро
          - Гулистон
          - Жиззах
          - Зангиота
          - М.Улуғбек
          - МАБ
          - Мирзо Улуғбек
          - Миробод
          - Навоий
          - Наманган
          - Нукус
          - Самарқанд
          - Термиз
          - Урганч
          - Фарғона
          - Чилонзор
          - Шаҳрисабз
          - Юнусобод
          - Яшнобод
          - Қарши
        description: Viloyatni tanlang
      - in: query
        name: year
        schema:
          type: integer
          enum:
          - 2024
          - 2025
          - 2026
        description: Yilni tanlang
      tags:
      - Analytics
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/TopExpenseATM'
          description: ''
  /api/v1/analytics/atms/top-income/:
    get:
      operationId: v1_analytics_atms_top_income_list
      description: Bankomatlarning haqiqiy daromadi (income) bo'yicha reytingi. Yechilgan
        naqd pul aylanmasi (cash_withdrawal), qilingan haqiqiy xarajatlar (zapchast
        + ijara + tok + inkassatsiya), sof foyda (net_profit) va rentabellik marjasi
        bilan birga to'liq bankomat pasporti.
      summary: Eng ko'p daromad keltirgan bankomatlar (Top Revenue ATMs)
      parameters:
      - in: query
        name: card_type
        schema:
          type: string
          enum:
          - HUMO
          - UZCARD
        description: Karta turini tanlang (UZCARD yoki HUMO)
      - in: query
        name: limit
        schema:
          type: integer
          default: 10
        description: 'Qaytariladigan bankomatlar soni (default: 10)'
      - in: query
        name: month
        schema:
          type: integer
          enum:
          - 1
          - 10
          - 11
          - 12
          - 2
          - 3
          - 4
          - 5
          - 6
          - 7
          - 8
          - 9
        description: Oyni tanlang (1-12)
      - in: query
        name: period
        schema:
          type: string
          enum:
          - all
          - monthly
          - yearly
        description: 'Davr turi (all: umumiy, yearly: yillik, monthly: oylik)'
      - in: query
        name: region
        schema:
          type: string
          enum:
          - Andijon
          - Булунғур
          - Булунғур БРМ
          - Бухоро
          - Гулистон
          - Жиззах
          - Зангиота
          - М.Улуғбек
          - МАБ
          - Мирзо Улуғбек
          - Миробод
          - Навоий
          - Наманган
          - Нукус
          - Самарқанд
          - Термиз
          - Урганч
          - Фарғона
          - Чилонзор
          - Шаҳрисабз
          - Юнусобод
          - Яшнобод
          - Қарши
        description: Viloyatni tanlang
      - in: query
        name: year
        schema:
          type: integer
          enum:
          - 2024
          - 2025
          - 2026
        description: Yilni tanlang
      tags:
      - Analytics
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/TopIncomeATM'
          description: ''
  /api/v1/analytics/overview/:
    get:
      operationId: v1_analytics_overview_retrieve
      description: 'Front-end boshqaruv paneli va monitoring uchun to''liq moliyaviy
        KPI xulosa: tarmoqning jami daromadi, yechilgan naqd pul aylanmasi, jami haqiqiy
        xarajatlar, sof foyda, tarmoq rentabelligi, eng serdaromad bankomat, eng xarajatli
        bankomat, eng foydali viloyat va zararda ishlayotgan (joyini almashtirish
        tavsiya etilgan) bankomatlar soni.'
      summary: Boshqaruv uchun o'tgan oy va davriy tezkor KPI xulosasi (Executive
        Overview)
      parameters:
      - in: query
        name: month
        schema:
          type: integer
          enum:
          - 1
          - 10
          - 11
          - 12
          - 2
          - 3
          - 4
          - 5
          - 6
          - 7
          - 8
          - 9
        description: Oyni tanlang (1-12)
      - in: query
        name: year
        schema:
          type: integer
          enum:
          - 2024
          - 2025
          - 2026
        description: Yilni tanlang (bo'sh qoldirilsa, oxirgi to'liq oy avtomatik hisoblanadi)
      tags:
      - Analytics
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ManagementOverviewResponse'
          description: ''
  /api/v1/analytics/regions/:
    get:
      operationId: v1_analytics_regions_list
      description: Viloyatlarning haqiqiy daromadi, bankomatlardan yechilgan naqd
        pul aylanmasi, haqiqiy xarajatlari (zapchastlar + ijara + tok + inkassatsiya
        + servis), sof foydasi, rentabellik marjasi, faol/soz/nosoz bankomatlari soni
        va bitta bankomatga to'g'ri keluvchi o'rtacha ko'rsatkichlar.
      summary: Viloyatlar kesimida moliyaviy tahlil va reyting (Top Regions)
      parameters:
      - in: query
        name: limit
        schema:
          type: integer
          default: 20
        description: 'Maksimal hududlar soni (default: 20)'
      - in: query
        name: month
        schema:
          type: integer
          enum:
          - 1
          - 10
          - 11
          - 12
          - 2
          - 3
          - 4
          - 5
          - 6
          - 7
          - 8
          - 9
        description: Oyni tanlang (1-12)
      - in: query
        name: sort_by
        schema:
          type: string
          enum:
          - atms_count
          - cash_withdrawal
          - expense
          - income
          - profit
          - profit_margin
        description: Saralash ustunini tanlang (income, expense, profit, profit_margin,
          atms_count, cash_withdrawal)
      - in: query
        name: year
        schema:
          type: integer
          enum:
          - 2024
          - 2025
          - 2026
        description: Yilni tanlang (bo'sh qoldirilsa, oxirgi davr olinadi)
      tags:
      - Analytics
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/RegionAnalyticsItem'
          description: ''
  /api/v1/atms/:
    get:
      operationId: v1_atms_list
      description: Returns a paginated list of ATMs. Supports search and filtering
        by status, region, card type, model and active status.
      summary: ATM list
      parameters:
      - in: query
        name: card_type
        schema:
          type: string
          enum:
          - HUMO
          - UZCARD
        description: Karta turini tanlang (UZCARD yoki HUMO)
      - in: query
        name: is_active
        schema:
          type: boolean
        description: Filter by active status (true or false).
      - in: query
        name: model
        schema:
          type: string
        description: Filter ATMs by model.
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: region
        schema:
          type: string
          enum:
          - Andijon
          - Булунғур
          - Булунғур БРМ
          - Бухоро
          - Гулистон
          - Жиззах
          - Зангиота
          - М.Улуғбек
          - МАБ
          - Мирзо Улуғбек
          - Миробод
          - Навоий
          - Наманган
          - Нукус
          - Самарқанд
          - Термиз
          - Урганч
          - Фарғона
          - Чилонзор
          - Шаҳрисабз
          - Юнусобод
          - Яшнобод
          - Қарши
        description: Viloyatni tanlang
      - in: query
        name: search
        schema:
          type: string
        description: Search by ATM name, region, terminal ID, merchant ID, serial
          number, address or model.
      - in: query
        name: status
        schema:
          type: string
          enum:
          - NOSOZ
          - SOZ
        description: Holatni tanlang (SOZ yoki NOSOZ)
      tags:
      - ATM
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedATMListList'
          description: ''
  /api/v1/atms/{id}/:
    get:
      operationId: v1_atms_retrieve
      description: Returns complete information about a single ATM including business
        data, technical data, monthly statistics and maintenance information.
      summary: ATM detail
      parameters:
      - in: path
        name: id
        schema:
          type: string
        required: true
      tags:
      - ATM
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ATMDetail'
          description: ''
  /api/v1/atms/{id}/ai-analysis/:
    post:
      operationId: v1_atms_ai_analysis_create
      description: Ko'rsatilgan ID dagi bankomatning statistikasi asosida Ollama sun'iy
        intellekti orqali tahliliy xulosa va tavsiyalar yaratish.
      summary: Bitta bankomat bo'yicha Ollama AI tahlili
      parameters:
      - in: path
        name: id
        schema:
          type: string
        required: true
      tags:
      - ATM AI
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ATMAIAnalysisResponse'
          description: ''
  /api/v1/atms/{id}/export/:
    get:
      operationId: v1_atm_single_excel_export
      description: Ko'rsatilgan ID yoki TID dagi bitta bankomatning barcha moliyaviy
        va texnik ma'lumotlarini .xlsx Excel fayl ko'rinishida yuklab olish.
      summary: Bitta bankomatning to'liq Excel hisoboti
      parameters:
      - in: path
        name: id
        schema:
          type: string
        required: true
      tags:
      - ATM
      security:
      - {}
      responses:
        '200':
          content:
            application/vnd.openxmlformats-officedocument.spreadsheetml.sheet:
              schema:
                type: string
                format: binary
          description: ''
  /api/v1/atms/export/:
    get:
      operationId: v1_atms_bulk_excel_export
      description: 'Barcha yoki filtrlangan bankomatlar ro''yxatini to''liq Excel
        (.xlsx) fayl qilib yuklab olish. Filtrlar: region, card_type, model, terminal_id,
        is_active.'
      summary: Barcha bankomatlarning umumiy Excel hisoboti
      tags:
      - ATM
      security:
      - {}
      responses:
        '200':
          content:
            application/vnd.openxmlformats-officedocument.spreadsheetml.sheet:
              schema:
                type: string
                format: binary
          description: ''
  /api/v1/atms/filters/:
    get:
      operationId: v1_atms_filters_retrieve
      description: Returns all available filter values for ATM list page. Frontend
        should call this endpoint once and use the returned values to populate filter
        dropdowns.
      summary: ATM filter options
      tags:
      - ATM
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ATMFilterOptionsResponse'
          description: ''
  /api/v1/dashboard/:
    get:
      operationId: v1_dashboard_retrieve
      description: 'Asosiy boshqaruv paneli uchun barcha ko''rsatkichlar: Umumiy holat
        (jami/faol/soz/nosoz), Moliya (daromad/xarajat/foyda), Ta''mirlash statistikasi,
        Top viloyatlar, Status grafigi, Karta turlari grafigi, Oylik moliyaviy dinamika,
        Modellar bo''yicha taqsimot, Ta''mirlash trendi va oxirgi 10 ta ta''mirlash
        aktlari.'
      summary: Dashboard to'liq tahliliy ko'rsatkichlari
      tags:
      - Dashboard
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Dashboard'
          description: ''
  /api/v1/maintenance/:
    get:
      operationId: v1_maintenance_list
      description: Protokollar bo'yicha bankomatlarga o'rnatilgan ehtiyot qismlar,
        bajarilgan ta'mirlash ishlari va xarajatlar ro'yxati (qidiruv va filtrlar
        bilan).
      summary: Ta'mirlash va ehtiyot qismlar ro'yxati
      parameters:
      - in: query
        name: date_from
        schema:
          type: string
          format: date
        description: Boshlang'ich sana (YYYY-MM-DD)
      - in: query
        name: date_to
        schema:
          type: string
          format: date
        description: Tugash sanasi (YYYY-MM-DD)
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - in: query
        name: part_name
        schema:
          type: string
        description: Ehtiyot qism nomi
      - in: query
        name: protocol_number
        schema:
          type: string
        description: Protokol raqami
      - in: query
        name: region
        schema:
          type: string
        description: Viloyat
      - in: query
        name: search
        schema:
          type: string
        description: Ehtiyot qism nomi, seriya raqami yoki filial bo'yicha qidiruv
      - in: query
        name: serial_number
        schema:
          type: string
        description: Seriya raqami
      - in: query
        name: terminal_id
        schema:
          type: string
        description: Terminal ID (TID)
      tags:
      - Maintenance
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedMaintenanceListList'
          description: ''
  /api/v1/maintenance/{id}/:
    get:
      operationId: v1_maintenance_retrieve
      description: Tanlangan ta'mirlash yozuvining barcha parametrlari (ehtiyot qism
        narxi, QQS, miqdori va protokol ma'lumotlari).
      summary: Bitta ta'mirlash elementi batafsil ma'lumoti
      parameters:
      - in: path
        name: id
        schema:
          type: string
        required: true
      tags:
      - Maintenance
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MaintenanceDetail'
          description: ''
  /api/v1/regions/ai-analysis/:
    post:
      operationId: v1_regions_ai_analysis_create
      description: Tanlangan viloyatning oylar va yillar kesimidagi statistikasi asosida
        Ollama LLM orqali tahlil va tavsiyalar olish.
      summary: Viloyat bo'yicha Ollama AI tahlili
      tags:
      - ATM AI
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RegionAIAnalysisRequest'
            examples:
              NamunaSo'rov(ViloyatTahlili):
                value:
                  region: Самарқанд
                  start_year: 2025
                  end_year: 2025
                  start_month: 1
                  end_month: 12
                summary: Namuna so'rov (Viloyat tahlili)
                description: Samarqand viloyati bo'yicha 2025-yil statistikasi tahlili
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RegionAIAnalysisRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RegionAIAnalysisRequest'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RegionAIAnalysisResponse'
          description: ''
  /api/v2/regions/ai-analysis/:
    post:
      operationId: v2_regions_ai_analysis_create
      description: Tanlangan viloyatning oylar va yillar kesimidagi statistikasi asosida
        Ollama LLM orqali tahlil va tavsiyalar olish.
      summary: Viloyat bo'yicha Ollama AI tahlili
      tags:
      - ATM AI
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RegionAIAnalysisRequest'
            examples:
              NamunaSo'rov(ViloyatTahlili):
                value:
                  region: Самарқанд
                  start_year: 2025
                  end_year: 2025
                  start_month: 1
                  end_month: 12
                summary: Namuna so'rov (Viloyat tahlili)
                description: Samarqand viloyati bo'yicha 2025-yil statistikasi tahlili
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RegionAIAnalysisRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RegionAIAnalysisRequest'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RegionAIAnalysisResponse'
          description: ''
components:
  schemas:
    ATMAIAnalysisResponse:
      type: object
      properties:
        analysis:
          type: string
          description: Bankomat bo'yicha Ollama LLM xulosasi
      required:
      - analysis
    ATMDetail:
      type: object
      properties:
        general:
          $ref: '#/components/schemas/ATMGeneralInfo'
        technical:
          $ref: '#/components/schemas/ATMTechnicalInfo'
        service_contract:
          allOf:
          - $ref: '#/components/schemas/ATMServiceContractInfo'
          nullable: true
        monthly_statistics:
          type: array
          items:
            $ref: '#/components/schemas/ATMMonthlyStatisticItem'
        yearly_statistics:
          type: array
          items:
            $ref: '#/components/schemas/ATMYearlyStatisticItem'
      required:
      - general
      - monthly_statistics
      - service_contract
      - technical
      - yearly_statistics
    ATMFilterOptionsResponse:
      type: object
      properties:
        status:
          type: array
          items:
            $ref: '#/components/schemas/FilterChoice'
        card_type:
          type: array
          items:
            $ref: '#/components/schemas/FilterChoice'
        regions:
          type: array
          items:
            type: string
        models:
          type: array
          items:
            type: string
        model_names:
          type: array
          items:
            type: string
        years:
          type: array
          items:
            type: integer
        months:
          type: array
          items:
            $ref: '#/components/schemas/MonthChoice'
        is_active:
          type: array
          items:
            $ref: '#/components/schemas/BooleanChoice'
      required:
      - card_type
      - is_active
      - model_names
      - models
      - months
      - regions
      - status
      - years
